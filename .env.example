# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 服務
PORT=3000

# 報名規則
MAX_PLAYERS=21
GAME_WEEKDAY=2            # 1=週一 … 7=週日，目前是週二比賽
DEADLINE_DAYS_BEFORE=1    # 截止在比賽前幾天
DEADLINE_HOUR=12          # 截止時刻（24 小時制）→ 週一 12:00
TIME_ZONE=Asia/Taipei

# 每週結算端點 /tasks/close?key=... 的密鑰，請自行產生一組亂數
TASK_KEY=

# 免費額度保護：每月 200 則，推播前若剩餘額度扣掉本次後低於此值就不推播
PUSH_ANNOUNCE=true
QUOTA_RESERVE=40

# Supabase（留空則改用本機 data/registrations.json，僅適合本機測試）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
